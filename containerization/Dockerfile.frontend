# Dockerfile for the Next.js Frontend (Multi-stage build)

# Stage 1: Build the Next.js application
FROM node:20-slim AS builder

WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend/package*.json ./frontend/

# Install dependencies
RUN cd frontend && npm install

# Copy the rest of the application code
COPY frontend/ ./frontend/

# Build the Next.js application
RUN cd frontend && npm run build

# Stage 2: Serve the Next.js application with a minimal runtime
FROM node:20-slim AS runner

WORKDIR /app

# Copy essential files from the builder stage
COPY --from=builder /app/frontend/.next ./frontend/.next
COPY --from=builder /app/frontend/public ./frontend/public
COPY --from=builder /app/frontend/package*.json ./frontend/

# Install only production dependencies for the Next.js runtime
# Next.js will use installed dependencies from .next, this is for any remaining runtime deps
RUN cd frontend && npm install --production

# Expose the port your app runs on (Cloud Run defaults to 8080)
EXPOSE 8080

# Define the command to start your Next.js application
# Cloud Run injects PORT environment variable, your app should use it.
CMD ["npm", "start", "--prefix", "frontend"]